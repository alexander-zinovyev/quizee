rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    
    function memberDoc(roomId) {
    	return get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    function isMember(roomId) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    function isHost(roomId) {
      return isMember(roomId) && memberDoc(roomId).data.role == "host";
    }

    function roomDoc(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId));
    }

    function memberTeam(roomId) {
      return memberDoc(roomId).data.team;
    }

    function roundDoc(roomId, roundId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)/rounds/$(roundId));
    }

    function isPresentingAnswer(roomId, roundId, questionId) {
      return roomDoc(roomId).data.presenting.withAnswer == true
        && roomDoc(roomId).data.presenting.round == roundId
        && roomDoc(roomId).data.presenting.question == questionId;
    }

    function validRoomState(state) {
      return state is string
        && (state == "pending" || state == "playing" || state == "ended");
    }

    function handRaisingEnabled(roomId) {
      return roomDoc(roomId).data.handRaisingEnabled == true;
    }

    function roomIsPlaying(roomId) {
      return roomDoc(roomId).data.state == "playing";
    }

    function teamExists(roomId, teamId) {
      return teamId == null || exists(/databases/$(database)/documents/rooms/$(roomId)/teams/$(teamId));
    }

    function activeAnswerRound(roomId, roundId) {
      return roundId != null
        && roundDoc(roomId, roundId).data.type in ["text", "image", "multi-step", "color", "sorting"]
        && roundDoc(roomId, roundId).data.state == "active";
    }

    match /rooms/{roomId} {
      // Public metadata only; keep sensitive fields out of this doc.
      allow read: if true;
      allow update:
        if isHost(roomId)
        && request.resource != null
        && validRoomState(request.resource.data.state)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["presenting"])
          || (!activeAnswerRound(roomId, resource.data.presenting.round)
            && !activeAnswerRound(roomId, request.resource.data.presenting.round)))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "state",
          "presenting",
          "handRaisingEnabled",
          "countdownEndsAt"
        ]);

      allow create, delete: if false; // server/Admin SDK only

      // Server-only password document(s).
      match /auth/{docId} {
        allow read, write: if false;
      }

      // Membership records (created by server or host).
      match /members/{memberId} {
        // Any member can read the full roster; any signed-in user can read their own doc to check membership.
        allow read: if signedIn() && (memberId == request.auth.uid || isMember(roomId));

        // Host can manage member docs (e.g., assign teams).
        allow create, update:
          if isHost(roomId)
          && request.resource != null
          && teamExists(roomId, request.resource.data.team)
          && (!("uid" in request.resource.data) || request.resource.data.uid == memberId);

        allow update:
          if request.auth != null
          && request.auth.uid == memberId
          && isMember(roomId)
          && roomIsPlaying(roomId)
          && (handRaisingEnabled(roomId) || request.resource.data.handRaised == false)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["handRaised", "handRaisedAt"]);

        allow delete: if isHost(roomId);
      }

      // Teams collection managed by host.
      match /teams/{teamId} {
        allow read: if isMember(roomId);

        allow create, update:
          if isHost(roomId)
          && request.resource != null
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0;
        
        allow delete: if isHost(roomId);

        match /rounds/{roundId} {
          allow read: if isMember(roomId) && memberTeam(roomId) == teamId;
          allow write: if false;
        }

        match /rounds/{roundId}/answers/{answerId} {
          allow read:
            if isMember(roomId)
            && (memberTeam(roomId) == teamId || (isHost(roomId) && roundDoc(roomId, roundId).data.type == "color"));
          allow write:
            if isMember(roomId)
            && memberTeam(roomId) == teamId
            && roundDoc(roomId, roundId).data.type == "image"
            && roomIsPlaying(roomId)
            && roundDoc(roomId, roundId).data.state == "active";
        }

        match /scores/{roundId} {
          allow read: if isMember(roomId);
          allow write: if isHost(roomId);
        }
      }

      match /rounds/{roundId} {
        allow read: if isMember(roomId);
        allow update: if isHost(roomId)
          && (!(resource.data.type in ["text", "image", "multi-step", "color", "sorting"])
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["state", "activeWindow"]));
        allow create, delete: if false;

        match /questions/{questionId} {
          allow read: if isMember(roomId);
          allow write: if false;
        }

        match /images/{imageId} {
          allow read: if isMember(roomId);
          allow write: if false;
        }

        match /answers/{answerId} {
          allow read:
            if isHost(roomId)
            || (isMember(roomId) && (
              (roundDoc(roomId, roundId).data.type == "sorting"
                && answerId == "order"
                && roundDoc(roomId, roundId).data.state == "closed"
                && roundDoc(roomId, roundId).data.gradingRequired == false)
              || (roundDoc(roomId, roundId).data.type != "sorting"
                && isPresentingAnswer(roomId, roundId, answerId))));
          allow write: if isHost(roomId);
        }

        match /teamAnswers/{teamId} {
          allow read:
            if isHost(roomId)
            || (
              isMember(roomId)
              && (
                roomDoc(roomId).data.state == "ended"
                || (
                  memberTeam(roomId) == teamId
                  && roundDoc(roomId, roundId).data.state == "closed"
                )
              )
            );
          allow write: if isHost(roomId);

          match /answers/{answerId} {
            allow read:
              if isHost(roomId)
              || (
                isMember(roomId)
                && (
                  roomDoc(roomId).data.state == "ended"
                  || (
                    memberTeam(roomId) == teamId
                    && roundDoc(roomId, roundId).data.state == "closed"
                  )
                )
              );
            allow write: if isHost(roomId);
          }
        }
      }
    }
  }
}
