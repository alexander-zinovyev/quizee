rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberDoc(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    function isMember(roomId) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    function isHost(roomId) {
      return isMember(roomId) && memberDoc(roomId).data.role == "host";
    }

    function roomDoc(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId));
    }

    function isTeamMember(roomId, teamId) {
      return isMember(roomId) && memberDoc(roomId).data.team == teamId;
    }

    function handRaisingEnabled(roomId) {
      let doc = roomDoc(roomId);
      return doc.data.state == "playing" && doc.data.handRaisingEnabled == true;
    }

    function validRoomState(state) {
      return state is string
        && (state == "pending" || state == "playing" || state == "ended");
    }

    function teamExists(roomId, teamId) {
      return teamId == null || exists(/databases/$(database)/documents/rooms/$(roomId)/teams/$(teamId));
    }

    match /rooms/{roomId} {
      // Public metadata only; keep sensitive fields out of this doc.
      allow read: if true;
      allow update:
        if isHost(roomId)
        && request.resource != null
        && validRoomState(request.resource.data.state)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["state", "presenting", "handRaisingEnabled", "countdownEndsAt"]);

      allow create, delete: if false; // server/Admin SDK only

      // Server-only password document(s).
      match /auth/{docId} {
        allow read, write: if false;
      }

      // Membership records (created by server or host).
      match /members/{memberId} {
        // Any member can read the full roster; any signed-in user can read their own doc to check membership.
        allow read: if signedIn() && (memberId == request.auth.uid || isMember(roomId));

        // Host can manage member docs (e.g., assign teams).
        allow write: if isHost(roomId);

        allow update:
          if request.auth != null
          && request.auth.uid == memberId
          && (handRaisingEnabled(roomId) || request.resource.data.handRaised == false)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["handRaised", "handRaisedAt"]);
      }

      // Teams collection managed by host.
      match /teams/{teamId} {
        allow read: if isMember(roomId);

        allow create, update:
          if isHost(roomId)
          && request.resource != null
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0;

        allow delete: if isHost(roomId);

        match /{docs=**} {
          allow read, write: if isHost(roomId);
          allow read: if isTeamMember(roomId, teamId);
        }

        match /messages/{messageId} {
          allow write: if isTeamMember(roomId, teamId);
        }

        match /rounds/{roundId}/{docs=**} {
          allow read, write: if isTeamMember(roomId, teamId);
        }
      }

      // Server-owned clue balances and purchased content.
      // Keep this at room scope so team-write grants cannot reach balances or unlocks.
      match /cluePurchases/{teamId}/rounds/{roundId} {
        allow read: if isHost(roomId) || isTeamMember(roomId, teamId);
        allow write: if false;
        match /openedClues/{clueId} {
          allow read: if isHost(roomId) || isTeamMember(roomId, teamId);
          allow write: if false;
        }
      }

      // Chat collection
      match /messages/{messageId} {
        allow read, write: if isMember(roomId);
      }

      // Quiz rounds collection
      match /rounds/{roundId} {
        allow read: if isMember(roomId); // allow everyone to list and read round documents
        allow write: if isHost(roomId);

        function roundDoc() {
          return get(/databases/$(database)/documents/rooms/$(roomId)/rounds/$(roundId));
        }

        match /{docs=**} {
          allow read, write: if isHost(roomId);
        }

        match /questions/{questionId} {
          allow read: if isMember(roomId) && roundDoc().data.state != "scheduled";

          match /clues/{clueId} {
            // Individual revealed documents only. Listing would expose hidden clues.
            allow get: if isMember(roomId) && roundDoc().data.type == "clues"
              && roundDoc().data.state == "closed"
              && roomDoc(roomId).data.presenting.round == roundId
              && roomDoc(roomId).data.presenting.question == questionId
              && clueId in roomDoc(roomId).data.presenting.revealedClueIds;
          }
        }

        match /images/{imageId} {
          allow read: if isMember(roomId) && roundDoc().data.state != "scheduled";
        }

        match /answers/{answerId} {
          allow read: if isMember(roomId) && roundDoc().data.state == "closed"
            && (roundDoc().data.type != "clues" ||
              (roomDoc(roomId).data.presenting.round == roundId &&
               roomDoc(roomId).data.presenting.question == answerId &&
               roomDoc(roomId).data.presenting.withAnswer == true));
        }

        match /teamAnswers/{teamId} {
          allow read: if isMember(roomId) && roundDoc().data.state == "closed";

          match /{docs=**} {
            allow read: if isMember(roomId) && roundDoc().data.state == "closed";
          }
        }
      }
    }
  }
}
