{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quizee.local/schemas/quiz.schema.json",
  "title": "Quizee Quiz Schema",
  "description": "Schema for quiz packs containing text, image, multi-step, and color rounds.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/round"
  },
  "$defs": {
    "hexColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "colorAsset": { "type": "string", "pattern": "^(?!/)(?!media/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(png|jpg|jpeg|webp)$" },
    "colorSvgAsset": { "type": "string", "pattern": "^(?!/)(?!media/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.svg$" },
    "regionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$" } },
    "colorScoring": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": {
          "mode": { "const": "threshold" }, "points": { "type": "number", "exclusiveMinimum": 0 }, "threshold": { "type": "number", "minimum": 0, "maximum": 10 }
        } },
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": {
          "mode": { "const": "closest" }, "points": { "type": "number", "exclusiveMinimum": 0 }, "tieTolerance": { "type": "number", "minimum": 0, "maximum": 10 }
        } }
      ]
    },
    "colorRasterQuestion": { "type": "object", "additionalProperties": false, "required": ["image", "mask", "initialColor", "targetColor"], "properties": {
      "image": { "$ref": "#/$defs/colorAsset" }, "mask": { "$ref": "#/$defs/colorAsset" }, "initialColor": { "$ref": "#/$defs/hexColor" }, "targetColor": { "$ref": "#/$defs/hexColor" }
    } },
    "colorSvgQuestion": { "type": "object", "additionalProperties": false, "required": ["image", "regionIds", "initialColor", "targetColor"], "properties": {
      "image": { "$ref": "#/$defs/colorSvgAsset" }, "regionIds": { "$ref": "#/$defs/regionIds" }, "initialColor": { "$ref": "#/$defs/hexColor" }, "targetColor": { "$ref": "#/$defs/hexColor" }
    } },
    "colorQuestion": { "oneOf": [{ "$ref": "#/$defs/colorRasterQuestion" }, { "$ref": "#/$defs/colorSvgQuestion" }] },
    "colorRound": { "type": "object", "additionalProperties": false, "required": ["type", "title", "questions", "scoring"], "properties": {
      "type": { "const": "color" }, "title": { "$ref": "#/$defs/nonEmptyText" }, "scoring": { "$ref": "#/$defs/colorScoring" }, "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/colorQuestion" } }
    } },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "relativeMediaPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!media/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(png|jpg|jpeg|gif|webp|svg|mp3|wav|ogg|m4a|mp4|mov|webm)$"
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "media": {
          "$ref": "#/$defs/relativeMediaPath"
        }
      },
      "anyOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "media"
          ]
        }
      ]
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stages"
      ],
      "properties": {
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stage"
          }
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hint",
        "stages"
      ],
      "properties": {
        "hint": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stage"
          }
        }
      }
    },
    "textQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "answer"
      ],
      "properties": {
        "prompt": {
          "$ref": "#/$defs/prompt"
        },
        "answer": {
          "$ref": "#/$defs/answer"
        }
      }
    },
    "imageQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "properties": {
        "prompt": {
          "$ref": "#/$defs/stage"
        },
        "image": {
          "$ref": "#/$defs/relativeMediaPath"
        }
      }
    },
    "multiStepQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "answer"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "answer": {
          "$ref": "#/$defs/answer"
        }
      }
    },
    "textRound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "questions"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "allowWager": { "type": "boolean" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/textQuestion"
          }
        }
      }
    },
    "imageRound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "questions"
      ],
      "properties": {
        "type": {
          "const": "image"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/imageQuestion"
          }
        }
      }
    },
    "multiStepRound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "pointsPerStep",
        "allowAnswerChanges",
        "questions"
      ],
      "properties": {
        "type": {
          "const": "multi-step"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "pointsPerStep": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "allowAnswerChanges": {
          "type": "boolean"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/multiStepQuestion"
          }
        }
      }
    },
    "round": {
      "oneOf": [
        { "$ref": "#/$defs/colorRound" },
        {
          "$ref": "#/$defs/textRound"
        },
        {
          "$ref": "#/$defs/imageRound"
        },
        {
          "$ref": "#/$defs/multiStepRound"
        }
      ]
    }
  }
}
